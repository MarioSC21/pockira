{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pockira",
  "version": "0.4.4",
  "identifier": "com.mario.pockira-multiplatform",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pockira",
        "width": 800,
        "height": 600,
        "minWidth": 480,
        "minHeight": 400,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "pockira"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3QjBBNzE0ODJFQTgzRDUKUldUVmcrcUNGS2V3VjZSMTVQcSs2dGxic1NyeFpFVS9Ld056VXFyMjV0NE5ueVJtbUhkcXRZbVoK",
      "endpoints": [
        "https://github.com/MarioSC21/pockira/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
